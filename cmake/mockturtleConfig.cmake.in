@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(_mockturtle_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
if(@MOCKTURTLE_ENABLE_ABC@)
  find_dependency(MockturtleABC)
endif()
if(@BILL_Z3@)
  find_dependency(MockturtleZ3)
endif()
if(@MOCKTURTLE_ENABLE_MATPLOTLIB@)
  find_dependency(Python3 COMPONENTS Development NumPy)
endif()
set(CMAKE_MODULE_PATH "${_mockturtle_module_path}")
unset(_mockturtle_module_path)
include("${CMAKE_CURRENT_LIST_DIR}/mockturtleTargets.cmake")
check_required_components(mockturtle)
